{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["tailwindcss"],
  "workspaces": {
    ".": {
      "entry": ["src/app/**/page.dev.tsx", "scripts/**/*.{ts,mts,mjs}"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,mts,mjs}"],
      "ignore": ["src/lib/supabase/database.types.ts", "src/components/bklit/**"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    }
  }
}
